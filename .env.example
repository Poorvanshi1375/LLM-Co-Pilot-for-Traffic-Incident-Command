# ── LLM keys (required) ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_studio_key_here
# Optional extra keys for failover, comma-separated
GROQ_API_KEYS=
GOOGLE_AI_API_KEYS=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# ── Mapbox (required) ───────────────────────────────────────────
MAPBOX_TOKEN=your_mapbox_token_here
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# ── Frontend → backend URL ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Security ────────────────────────────────────────────────────
# Operator token for settings that affect everyone (auto-post, auto-detect)
ADMIN_TOKEN=change_me
# Browser origins allowed to call the API (comma-separated). Vercel URLs for
# this project are also allowed by default via ALLOWED_ORIGIN_REGEX.
ALLOWED_ORIGINS=https://llm-co-pilot-for-traffic-incident-c.vercel.app,http://localhost:3000

# ── Behaviour ───────────────────────────────────────────────────
AUTO_DETECT_INCIDENTS=false
TWITTER_ENABLED=false
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
